%-------------------------
% Custom commands
\newcommand{\resumeItem}[1]{
  \item\small{
    #1 \vspace{-2pt}
  }
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-2pt}\item
    \begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{ #1} & #2 \\
      \textit{\small #3} & \textit{\small #4} \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeSubSubheading}[2]{
    \item
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
      \textit{\small #1} & \textit{\small #2} \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeProjectHeading}[2]{
    \item
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
      \small #1 & #2 \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeSubItem}[1]{\resumeItem{ #1}\vspace{-4pt}}

\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.15in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-5pt}}

%-------------------------------------------
%%%%%%  RESUME STARTS HERE  %%%%%%%%%%%%%%%%%%%%%%%%%%%%

\begin{document}

%----------HEADING----------
\begin{center}
    \textbf{\Huge \scshape {{ personal_info.name }}} \\ \vspace{1pt}
    \small {{ personal_info.location }} $|$ \href{mailto:{{ personal_info.email }}}{\underline{ {{ personal_info.email }} }} $|$ {{ personal_info.phone }} 
    {% if personal_info.links %}
        {% for link in personal_info.links %}
        $|$ \href{https://{{ link }}}{\underline{ {{ link }} }}
        {% endfor %}
    {% endif %}
\end{center}

{% if content.professional_summary %}
%-----------SUMMARY-----------
\section{Profile}
  \small{
    {{ content.professional_summary }}
  }
{% endif %}

{% if content.education_section and content.education_section|length > 0 %}
%-----------EDUCATION-----------
\section{Education}
  \resumeSubHeadingListStart
    {% for edu in content.education_section %}
      \resumeSubheading
        { {{ edu.institution }} }{ {{ edu.location or '' }} }
        { {{ edu.degree }} }{ {{ edu.date or '' }} }
      {% if edu.details %}
        \resumeItemListStart
          \resumeItem{ {{ edu.details }} }
        \resumeItemListEnd
      {% endif %}
    {% endfor %}
  \resumeSubHeadingListEnd
{% endif %}

{% if content.experience_section and content.experience_section|length > 0 %}
%-----------EXPERIENCE-----------
\section{Experience}
  \resumeSubHeadingListStart
    {% for exp in content.experience_section %}
      \resumeSubheading
        { {{ exp.role }} }{ {{ exp.date or '' }} }
        { {{ exp.company }} }{ {{ exp.location or '' }} }
      {% if exp.bullets and exp.bullets|length > 0 %}
        \resumeItemListStart
          {% for bullet in exp.bullets %}
            \resumeItem{ {{ bullet }} }
          {% endfor %}
        \resumeItemListEnd
      {% endif %}
    {% endfor %}
  \resumeSubHeadingListEnd
{% endif %}

{% if content.projects_section and content.projects_section|length > 0 %}
%-----------PROJECTS-----------
\section{Projects}
  \resumeSubHeadingListStart
    {% for proj in content.projects_section %}
      \resumeProjectHeading
        {\textbf{ {{ proj.name }} }{% if proj.technologies %} $|$ \emph{ {{ proj.technologies }} }{% endif %}}{ {{ proj.date or '' }} }
      {% if proj.bullets and proj.bullets|length > 0 %}
        \resumeItemListStart
          {% for bullet in proj.bullets %}
            \resumeItem{ {{ bullet }} }
          {% endfor %}
        \resumeItemListEnd
      {% endif %}
    {% endfor %}
  \resumeSubHeadingListEnd
{% endif %}

{% if content.skills_section and content.skills_section|length > 0 %}
%-----------TECHNICAL SKILLS-----------
\section{Technical Skills}
 \begin{itemize}[leftmargin=0.15in, label={}]
    \small{\item{
     \textbf{Skills}{: {{ content.skills_section | join(', ') }}}
    }}
 \end{itemize}
{% endif %}

{% if content.certifications_section and content.certifications_section|length > 0 %}
%-----------ACHIEVEMENTS-----------
\section{Achievements}
  \resumeSubHeadingListStart
    {% for item in content.certifications_section %}
      \resumeItem{ {{ item }} }
    {% endfor %}
  \resumeSubHeadingListEnd
{% endif %}

\end{document}
