# Copy this file to .env and add your local LangSmith API key.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=resume-agent
OPENCODE_API_KEY=your-opencode-api-key
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=muse-spark-1.3-contributor-free
OPENCODE_PROXY_URL=http://127.0.0.1:8000/v1
OPENCODE_SERVER_URL=http://127.0.0.1:4097
OPENCODE_PROVIDER_ID=opencode
GEMMA_API_KEY=
GEMMA_BASE_URL=http://127.0.0.1:8787/v1
GEMMA_MODEL=gemma-e2b
GEMMA_MAX_TOKENS=2048
